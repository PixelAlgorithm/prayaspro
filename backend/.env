# PrayasPro Database Configuration
PORT=5001
DATABASE_URL=postgresql://postgres:root@localhost:5432/prayaspro

# Direct connection parameters (fallback)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=root
PGDATABASE=prayaspro

# Authentication Secrets
JWT_SECRET=prayaspro_super_secret_jwt_key_pesu_dbms_level_3_2026
NEXTAUTH_SECRET=prayaspro_super_secret_jwt_key_pesu_dbms_level_3_2026

# Vector Configuration
VECTOR_DIMENSION=384
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App Configuration
NEXT_PUBLIC_APP_NAME="PrayasPro"
NEXT_PUBLIC_APP_URL=http://localhost:3000
