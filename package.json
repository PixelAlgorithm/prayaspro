{
  "name": "prayaspro-root",
  "version": "1.0.0",
  "description": "PrayasPro Root Workspace Runner",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:synthetic": "npm --prefix backend run db:synthetic",
    "db:reset": "npm --prefix backend run db:reset",
    "test:flow": "npm --prefix backend run test:flow",
    "test:queries": "npm --prefix backend run test:queries",
    "test:smoke": "node frontend/scripts/smoke-test.mjs"
  }
}
